{
	"schemaVersion": 1,
	"id": "relaxed-qol",
	"version": "${version}",
	"name": "Relaxed QOL",
	"description": "Relaxed QOL: quality-of-life tools for Minecraft",
	"authors": [
		"RelaxedClient"
	],
	"license": "LicenseRef-PolyForm-Strict-1.0.0",
	"icon": "assets/relaxed-qol/icon.png",
